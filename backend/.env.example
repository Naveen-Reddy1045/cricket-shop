# ─────────────────────────────────────────────────────────────────────────────
# Cricket Shop Backend — Required Environment Variables
# Copy this file to .env and fill in all values before running locally.
# On production (Railway / Render / Docker), set these as env vars on the host.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cricketshop?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_strong_db_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure key with: openssl rand -base64 64
JWT_SECRET_KEY=replace_with_a_secure_256bit_base64_key
# Token expiry in milliseconds (default 1 hour = 3600000)
JWT_EXPIRATION=3600000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev:
ALLOWED_ORIGINS=http://localhost:5173
# Production example:
# ALLOWED_ORIGINS=https://your-frontend-domain.com
